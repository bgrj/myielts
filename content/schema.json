{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyIELTS bot publishing feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "botId",
    "revision",
    "updatedAt",
    "publisher",
    "cards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "reading",
        "listening"
      ]
    },
    "botId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "publisher": {
      "enum": [
        "initialization",
        "grok",
        "verified-feedback"
      ]
    },
    "cards": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "reading"
          }
        }
      },
      "then": {
        "properties": {
          "botId": {
            "const": "0eca5200-224b-4af8-b13a-6fd4f4762592"
          },
          "cards": {
            "items": {
              "properties": {
                "kind": {
                  "const": "reading"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "listening"
          }
        }
      },
      "then": {
        "properties": {
          "botId": {
            "const": "e79fc4f8-184b-450b-b10e-a21f91070599"
          },
          "cards": {
            "items": {
              "properties": {
                "kind": {
                  "const": "listening"
                }
              },
              "required": [
                "audio",
                "audioSource"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "target",
        "sentence",
        "focus",
        "source",
        "originalRef",
        "translation",
        "feedback",
        "note",
        "sourceVerified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
        },
        "kind": {
          "enum": [
            "reading",
            "listening"
          ]
        },
        "target": {
          "type": "string",
          "maxLength": 12000,
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "maxLength": 12000
        },
        "sentence": {
          "type": "string",
          "maxLength": 12000,
          "minLength": 1
        },
        "focus": {
          "type": "string",
          "maxLength": 12000,
          "minLength": 1
        },
        "source": {
          "type": "string",
          "maxLength": 12000,
          "minLength": 1
        },
        "title": {
          "type": "string",
          "maxLength": 12000
        },
        "translation": {
          "type": "string",
          "maxLength": 12000,
          "minLength": 1
        },
        "ipa": {
          "type": "string",
          "maxLength": 12000
        },
        "note": {
          "type": "string",
          "maxLength": 12000,
          "minLength": 1
        },
        "collocations": {
          "type": "string",
          "maxLength": 12000
        },
        "related": {
          "type": "string",
          "maxLength": 12000
        },
        "etymology": {
          "type": "string",
          "maxLength": 12000
        },
        "personalError": {
          "type": "string",
          "maxLength": 12000
        },
        "originalRef": {
          "type": "string",
          "maxLength": 12000,
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "maxLength": 12000
        },
        "feedback": {
          "type": "string",
          "maxLength": 12000,
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "maxLength": 12000
        },
        "pronunciation": {
          "type": "string",
          "maxLength": 12000
        },
        "grammar": {
          "type": "string",
          "maxLength": 12000
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 30
          }
        },
        "fragment": {
          "type": "boolean"
        },
        "sourceVerified": {
          "const": true
        },
        "audio": {
          "type": "object",
          "required": [
            "url",
            "start",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "audioSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      }
    }
  }
}
